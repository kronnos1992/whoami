# EmailJS — https://www.emailjs.com/docs/
# 1) Cria uma conta gratuita em emailjs.com
# 2) Liga um serviço de email (Service ID) em Email Services
# 3) Cria um template em Email Templates com as variáveis:
#    {{from_name}}, {{from_email}}, {{subject}}, {{message}} e Reply-To {{from_email}}
# 4) Copia a Public Key (Account → API Keys) e preenche abaixo
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
